  # pkg:gem/toys-core#lib/toys/errors.rb:117
  def config_line; end

  # pkg:gem/toys-core#lib/toys/errors.rb:107
  def config_path; end

  # @private
  #
  # pkg:gem/toys-core#lib/toys/errors.rb:161
