# @return [Object]
#
# pkg:gem/toys-core#lib/toys/context.rb:125
Toys::Context::Key::TOOL_SOURCE = T.let(T.unsafe(nil), Toys::UniqueKey)

# Context key for all unmatched args in order. The value is an array of
