  # via a regular expression. It uses the acceptor to validate values
  # passed to a flag.
  #
  #     tool "example" do
  #       acceptor "hex", /[0-9a-fA-F]+/, type_desc: "hex numbers"
  #       flag :number, accept: "hex"
  #       def run
  #         puts "number was #{number}"
  #       end
  #     end
